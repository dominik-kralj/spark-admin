{
  "$comment": "SPARK Admin design tokens. Source of truth for colour, type and sizing. Contrast ratios are WCAG 2.x, computed against white (#FFFFFF) and the page background gray.50 (#F6F7F9).",
  "colors": {
    "navy.900": { "value": "#03112D", "use": "Headings, logo tile, current page marker, filter count", "onWhite": 18.72, "onGray50": 17.46 },
    "blue.500": { "value": "#2196F3", "use": "Brand accent in the logo only. Never text, links or controls", "onWhite": 3.12, "onGray50": 2.91 },
    "blue.700": { "value": "#1565C0", "use": "Links, primary buttons, focus ring", "onWhite": 5.75, "onGray50": 5.36 },
    "blue.800": { "value": "#0D47A1", "use": "Link hover, text on blue.50", "onWhite": 8.63, "onGray50": 8.05 },
    "blue.50": { "value": "#E8F1FB", "use": "Current nav item, processing chip, new-tickets banner", "surface": true },
    "gray.900": { "value": "#18202B", "use": "Body text", "onWhite": 16.40, "onGray50": 15.30 },
    "gray.700": { "value": "#3D4755", "use": "Secondary text, nav labels, table headers", "onWhite": 9.41, "onGray50": 8.78 },
    "gray.600": { "value": "#56606E", "use": "Help text, captions, placeholders", "onWhite": 6.38, "onGray50": 5.95 },
    "gray.500": { "value": "#6E7887", "use": "Input and button borders, inactive icons (needs 3:1)", "onWhite": 4.47, "onGray50": 4.17 },
    "gray.200": { "value": "#E1E5EA", "use": "Dividers and card outlines, decorative only", "onWhite": 1.27, "onGray50": 1.18 },
    "gray.100": { "value": "#EEF1F4", "use": "Pending chip, read-only fields, segmented control, tinted rows on phone", "surface": true },
    "gray.50": { "value": "#F6F7F9", "use": "Page background, table header, tinted rows on desktop", "surface": true },
    "white": { "value": "#FFFFFF", "use": "Cards, tables, inputs, drawers, dialogs", "surface": true },
    "green.800": { "value": "#14532D", "use": "Text and icon on green.50", "onWhite": 9.11, "onGray50": 8.50 },
    "green.700": { "value": "#1B6B3A", "use": "Success icon and toast border", "onWhite": 6.54, "onGray50": 6.10 },
    "green.50": { "value": "#E7F4EC", "use": "Done, valid and active chips", "surface": true },
    "red.800": { "value": "#8E1B16", "use": "Text and icon on red.50", "onWhite": 9.06, "onGray50": 8.45 },
    "red.700": { "value": "#B42318", "use": "Error text and border, destructive button", "onWhite": 6.57, "onGray50": 6.13 },
    "red.50": { "value": "#FDECEA", "use": "Fail and expired chips, error summary", "surface": true },
    "scrim": { "value": "rgba(3, 17, 45, 0.45)", "use": "Behind drawers and dialogs (navy.900 at 45 %)" }
  },
  "pairs": [
    { "fg": "gray.900", "bg": "white", "ratio": 16.40, "needs": 4.5, "use": "Body text" },
    { "fg": "gray.600", "bg": "white", "ratio": 6.38, "needs": 4.5, "use": "Help text, captions" },
    { "fg": "gray.600", "bg": "gray.100", "ratio": 5.62, "needs": 4.5, "use": "Captions on tinted cards" },
    { "fg": "blue.700", "bg": "white", "ratio": 5.75, "needs": 4.5, "use": "Links, ghost buttons" },
    { "fg": "white", "bg": "blue.700", "ratio": 5.75, "needs": 4.5, "use": "Primary button" },
    { "fg": "blue.800", "bg": "blue.50", "ratio": 7.57, "needs": 4.5, "use": "Processing chip, current nav item" },
    { "fg": "gray.700", "bg": "gray.100", "ratio": 8.30, "needs": 4.5, "use": "Pending chip" },
    { "fg": "green.800", "bg": "green.50", "ratio": 8.05, "needs": 4.5, "use": "Done chip" },
    { "fg": "red.800", "bg": "red.50", "ratio": 7.92, "needs": 4.5, "use": "Fail chip, error summary" },
    { "fg": "red.700", "bg": "white", "ratio": 6.57, "needs": 4.5, "use": "Field error text" },
    { "fg": "white", "bg": "red.700", "ratio": 6.57, "needs": 4.5, "use": "Destructive button" },
    { "fg": "white", "bg": "navy.900", "ratio": 18.72, "needs": 4.5, "use": "Current page button, filter count" },
    { "fg": "gray.500", "bg": "white", "ratio": 4.47, "needs": 3, "use": "Input and button border" },
    { "fg": "blue.700", "bg": "gray.50", "ratio": 5.36, "needs": 3, "use": "Focus ring on the page" },
    { "fg": "green.700", "bg": "white", "ratio": 6.54, "needs": 3, "use": "Success toast border and icon" }
  ],
  "statusChips": {
    "PENDING": { "bg": "gray.100", "fg": "gray.700", "icon": "clock", "payment": "Na čekanju", "fiscalization": "Na čekanju" },
    "PROCESSING": { "bg": "blue.50", "fg": "blue.800", "icon": "refresh-cw", "payment": "U obradi", "fiscalization": "U obradi" },
    "DONE": { "bg": "green.50", "fg": "green.800", "icon": "check", "payment": "Plaćeno", "fiscalization": "Fiskalizirano" },
    "FAIL": { "bg": "red.50", "fg": "red.800", "icon": "x", "payment": "Neuspjelo", "fiscalization": "Neuspjelo" }
  },
  "otherChips": {
    "valid": { "bg": "green.50", "fg": "green.800", "icon": "check", "label": "Važeće" },
    "expired": { "bg": "red.50", "fg": "red.800", "icon": "calendar-x", "label": "Isteklo" },
    "active": { "bg": "green.50", "fg": "green.800", "icon": "check", "label": "Aktivan" },
    "inactive": { "bg": "gray.100", "fg": "gray.700", "icon": "circle-minus", "label": "Neaktivan" }
  },
  "fonts": {
    "body": "'IBM Plex Sans', system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace",
    "weights": [400, 500, 600],
    "googleFonts": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
  },
  "typeScale": {
    "$comment": "font-size / line-height in px. Implement in rem.",
    "pageTitle": { "element": "h1", "desktop": "24/32", "phone": "22/28", "weight": 600, "color": "navy.900" },
    "sectionTitle": { "element": "h2", "desktop": "18/28", "phone": "18/26", "weight": 600, "color": "navy.900" },
    "subsection": { "element": "h3", "desktop": "16/24", "phone": "16/24", "weight": 600, "color": "navy.900" },
    "body": { "desktop": "14/20", "phone": "16/24", "weight": 400, "color": "gray.900" },
    "label": { "desktop": "14/20", "phone": "14/20", "weight": 500, "color": "gray.900" },
    "tableHeader": { "desktop": "13/20", "phone": "13/18", "weight": 600, "color": "gray.700" },
    "caption": { "desktop": "13/18", "phone": "13/18", "weight": 400, "color": "gray.600" },
    "chip": { "desktop": "13/18", "phone": "13/18", "weight": 500 },
    "code": { "font": "mono", "desktop": "14/20", "phone": "17/24", "weight": 600, "use": "Plates in tables and cards" },
    "codeLong": { "font": "mono", "desktop": "14/20", "phone": "14/20", "weight": 400, "use": "OIB, IBAN, JIR, ZKI, transaction number" },
    "minimumSize": "13px"
  },
  "radii": { "chip": "4px", "control": "6px", "card": "8px" },
  "sizes": {
    "control": { "desktop": "40px", "touch": "48px" },
    "button": { "desktop": "40px", "touch": "44px to 48px" },
    "iconButton": { "desktop": "36px to 40px", "touch": "44px" },
    "minTouchTarget": "44px",
    "chip": "24px",
    "tableRow": { "desktop": "48px", "tablet": "52px" },
    "tableHeader": "44px",
    "sidebar": { "desktop": "248px", "tabletRail": "72px", "phoneDrawer": "304px" },
    "header": { "desktop": "64px", "phone": "56px" },
    "drawer": { "desktop": "560px", "phone": "100%" },
    "formMaxWidth": "800px"
  },
  "spacing": {
    "pagePadding": { "desktop": "32px", "tablet": "24px", "phone": "16px" },
    "cardPadding": { "desktop": "16px to 24px", "phone": "16px" },
    "fieldGap": "20px",
    "labelToInput": "6px",
    "tableCellPaddingX": { "desktop": "16px", "tablet": "12px" }
  },
  "breakpoints": {
    "$comment": "Chakra v3 defaults.",
    "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px",
    "behaviour": {
      "belowMd": "Top bar with menu button, nav in a drawer, tables become cards, forms one column, detail and forms full screen",
      "mdToLg": "72 px icon rail, table with fewer columns, filters behind the Filteri button, forms two columns",
      "lgAndUp": "248 px sidebar, full table, inline filter bar, 560 px drawers"
    }
  },
  "focusRing": { "width": "2px", "offset": "2px", "color": "blue.700" },
  "elevation": {
    "toast": "0 4px 12px rgba(3, 17, 45, 0.12)",
    "dialog": "0 8px 24px rgba(3, 17, 45, 0.20)",
    "note": "Cards, tables and drawers use a 1 px gray.200 border and no shadow."
  },
  "icons": { "set": "Lucide", "strokeWidth": 2, "sizes": { "inChip": "14px", "inButton": "16px", "nav": "18px to 22px" } }
}
