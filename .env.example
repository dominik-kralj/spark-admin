# Copy to .env.local (gitignored) and fill in. Vite exposes every VITE_* value
# to the browser bundle, so treat none of these as secret.

# Backend origin, without the /api/v1 base path. Example: https://spark.example.hr
VITE_API_BASE_URL=
# X-API-KEY issued by Softlab.
VITE_API_KEY=
# true = intercept all API calls with the MSW mock in src/mocks.
VITE_API_MOCK=false
